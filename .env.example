# Copy to .env.local for development. These are PUBLIC build-time values —
# they are compiled into the browser bundle. Never put secrets here.
VITE_API_BASE_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
# Base path, only if hosted under a sub-path (default /).
# VITE_BASE_PATH=/app/
# Public site address for share previews, canonical links and the sitemap
# (also read by api/share.js and api/sitemap.js). No trailing slash.
VITE_PUBLIC_SITE_URL=https://bimanage-frontend.vercel.app
