{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/share.js": { "includeFiles": "dist/index.html", "maxDuration": 10 },
    "api/sitemap.js": { "maxDuration": 15 }
  },
  "rewrites": [
    {
      "source": "/s/:slug/products/:productId",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(facebookexternalhit|facebookcatalog|Facebot|meta-externalagent|LinkedInBot|WhatsApp|Twitterbot|Slackbot|TelegramBot|Discordbot|Pinterest|redditbot|Embedly|SkypeUriPreview|vkShare|Iframely|Viber|Mastodon|Bluesky|Cardyb).*" }],
      "destination": "/api/share?slug=:slug&productId=:productId"
    },
    {
      "source": "/s/:slug",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(facebookexternalhit|facebookcatalog|Facebot|meta-externalagent|LinkedInBot|WhatsApp|Twitterbot|Slackbot|TelegramBot|Discordbot|Pinterest|redditbot|Embedly|SkypeUriPreview|vkShare|Iframely|Viber|Mastodon|Bluesky|Cardyb).*" }],
      "destination": "/api/share?slug=:slug"
    },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/robots.txt", "destination": "/api/robots" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://res.cloudinary.com https://*.googleusercontent.com; font-src 'self'; connect-src 'self' https://bimanage-backend.onrender.com wss://bimanage-backend.onrender.com https://*.ingest.sentry.io https://*.ingest.us.sentry.io https://*.ingest.de.sentry.io; media-src 'self' blob:; worker-src 'self' blob:; manifest-src 'self'; frame-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), magnetometer=(), gyroscope=(), accelerometer=(), browsing-topics=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" }
      ]
    },
    {
      "source": "/:section(admin|dashboard|onboarding|inventory|sales|orders|reports|analytics|invoices|projects|settings|social|store|messages|notifications|support|feli|subscription|wallet|bisupplynet|more|verify|forgot-password|reset-password|oauth|session-expired|account-closing|account-closed|invite|unsubscribe|ui-kit)/:rest*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/s/:slug/:page(cart|checkout|payment|track|chat)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/reviews/:page(write|submitted)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ]
}
