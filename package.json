{
  "name": "bimanage-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "BiManage web app (BiTechTeam Limited)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "dev": "npm run tokens && vite",
    "build": "npm run tokens && tsc -b && vite build && node scripts/check-bundle.mjs && node scripts/check-csp.mjs",
    "check:layout": "node scripts/check-layout.mjs",
    "check:layout:charts": "node scripts/check-layout-charts.mjs",
    "build:layout": "npm run tokens && node scripts/layout/build.mjs",
    "build:local": "npm run tokens && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "screenshots:marketing": "node scripts/marketing/screenshots.mjs"
  },
  "dependencies": {
    "@fontsource/poppins": "5.1.0",
    "@hookform/resolvers": "3.9.1",
    "@sentry/react": "11.10.0",
    "@tabler/icons-react": "3.24.0",
    "@tanstack/react-query": "5.62.7",
    "clsx": "2.1.1",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.54.0",
    "react-router-dom": "6.30.6",
    "socket.io-client": "^4.8.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "22.10.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "jsdom": "25.0.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.7.2",
    "vite": "^6.4.6",
    "vitest": "5.0.5"
  }
}
